package templates

import (
	"fmt"
	"github.com/kubecron/kubecron/internal/storage"
)

type RunDetailData struct {
	Run       storage.JobRun
	CronJob   storage.CronJob
	ClusterID string
	LogLines  []storage.LogLine
}

templ RunDetail(d RunDetailData) {
	@Layout(fmt.Sprintf("Run %s", d.Run.ID[:8])) {
		<div class="container">
			// Header breadcrumb
			<div style="font-family:var(--font-mono);font-size:0.85rem;color:var(--text-muted);margin-bottom:1rem;">
				<a href="/" style="color:var(--text-muted);text-decoration:none;">clusters</a>
				<span style="color:var(--border)"> / </span>
				<a href={ templ.SafeURL(fmt.Sprintf("/clusters/%s", d.ClusterID)) } style="color:var(--text-muted);text-decoration:none;">{ d.ClusterID }</a>
				<span style="color:var(--border)"> / </span>
				{ d.CronJob.Namespace }/{ d.CronJob.Name }
				<span style="color:var(--border)"> / </span>
				<span style="color:var(--accent);">{ d.Run.ID[:8] }...</span>
			</div>

			// Run metadata card
			<div class="card" style="margin-bottom:1rem;">
				<div style="display:flex;flex-wrap:wrap;gap:1.5rem;align-items:center;">
					<span class={ "badge", templ.KV("badge-success", d.Run.Status=="succeeded"), templ.KV("badge-failed", d.Run.Status=="failed"), templ.KV("badge-running", d.Run.Status=="running") } style="font-size:0.9rem;">{ d.Run.Status }</span>
					<span style="font-family:var(--font-mono);font-size:0.85rem;">trigger: <span style="color:var(--accent);">{ d.Run.Trigger }</span></span>
					if d.Run.DurationMs != nil {
						<span style="font-family:var(--font-mono);font-size:0.85rem;">duration: <span style="color:var(--accent);">{ fmt.Sprintf("%dms", *d.Run.DurationMs) }</span></span>
					}
					if d.Run.ExitCode != nil {
						<span style="font-family:var(--font-mono);font-size:0.85rem;">exit: <span style="color:var(--accent);">{ fmt.Sprintf("%d", *d.Run.ExitCode) }</span></span>
					}
					if d.Run.NodeName != nil {
						<span style="font-family:var(--font-mono);font-size:0.85rem;color:var(--text-muted);">node: { *d.Run.NodeName }</span>
					}
					if d.Run.ContainerImage != nil {
						<span style="font-family:var(--font-mono);font-size:0.85rem;color:var(--text-muted);">image: { *d.Run.ContainerImage }</span>
					}
					<span style="font-family:var(--font-mono);font-size:0.85rem;color:var(--text-muted);">
						{ fmt.Sprintf("%.1f KB", float64(d.Run.LogSizeBytes)/1024) }
					</span>
				</div>
			</div>

			// Resource charts (if metrics available)
			if d.Run.AvgCPUMillicores != nil {
				<div class="card" style="margin-bottom:1rem;" id="resource-charts">
					<h3 style="font-family:var(--font-mono);color:var(--text-muted);font-size:0.85rem;margin-bottom:1rem;">RESOURCE USAGE</h3>
					<div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
						<div><canvas id="cpuChart"></canvas></div>
						<div><canvas id="memChart"></canvas></div>
					</div>
				</div>
				<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.9"></script>
				<script>
					async function loadCharts() {
						const resp = await fetch('/api/runs/{ d.Run.ID }/resources');
						const data = await resp.json();
						const labels = data.samples.map(s => new Date(s.sampled_at).toLocaleTimeString());
						const cpuData = data.samples.map(s => s.cpu_millicores);
						const memData = data.samples.map(s => Math.round(s.memory_bytes/1048576));
						const chartOpts = (label, data, color) => ({
							type:'line', data:{labels, datasets:[{label, data, borderColor:color, backgroundColor:color+'22', fill:true, tension:0.3, pointRadius:2}]},
							options:{responsive:true, scales:{y:{beginAtZero:true, grid:{color:'#1e1e2e'}, ticks:{color:'#6e7681'}}, x:{grid:{color:'#1e1e2e'}, ticks:{color:'#6e7681', maxTicksLimit:8}}}, plugins:{legend:{labels:{color:'#c9d1d9'}}}}
						});
						new Chart(document.getElementById('cpuChart'), chartOpts('CPU (m)', cpuData, '#00ff88'));
						new Chart(document.getElementById('memChart'), chartOpts('Memory (MiB)', memData, '#00aaff'));
					}
					loadCharts();
					if ('{ d.Run.Status }' === 'running') setInterval(loadCharts, 15000);
				</script>
			}

			// Log terminal
			<div class="card">
				<h3 style="font-family:var(--font-mono);color:var(--text-muted);font-size:0.85rem;margin-bottom:0.75rem;">LOGS</h3>
				if d.Run.Status == "running" {
					<div id="log-term" class="log-terminal" hx-ext="sse" sse-connect={ fmt.Sprintf("/api/runs/%s/stream", d.Run.ID) } sse-swap="message" hx-swap="beforeend"></div>
				} else {
					<div id="log-term" class="log-terminal">
						for _, l := range d.LogLines {
							{ l.Line }
							{ "\n" }
						}
					</div>
				}
			</div>
		</div>
		<script src="https://unpkg.com/htmx-ext-sse@2.2.2/sse.js" defer></script>
		<script>
			// Auto-scroll log terminal
			const term = document.getElementById('log-term');
			if (term) {
				const obs = new MutationObserver(() => term.scrollTop = term.scrollHeight);
				obs.observe(term, {childList:true, subtree:true});
				term.scrollTop = term.scrollHeight;
			}
		</script>
	}
}
