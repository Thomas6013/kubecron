package templates

templ Stats() {
	@Layout("Stats") {
		<div class="container">
			<h1 style="font-family:var(--font-mono);color:var(--accent);">Stats</h1>
			<p style="color:var(--text-muted);font-family:var(--font-mono);">Use the /api endpoints and Prometheus /metrics for detailed statistics.</p>
		</div>
	}
}
