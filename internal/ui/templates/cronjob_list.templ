package templates

import (
	"fmt"
	"time"
	"github.com/kubecron/kubecron/internal/storage"
)

type CronJobRow struct {
	storage.CronJob
	NextRunAt time.Time
	LastRun   *storage.JobRun
	Stats7d   *storage.RunStats
}

templ CronJobList(clusterID string, rows []CronJobRow) {
	@Layout(clusterID) {
		<div class="container">
			<h1 style="font-family:var(--font-mono);color:var(--accent);margin-bottom:1.5rem;">
				<a href="/" style="color:var(--text-muted);text-decoration:none;">clusters</a>
				<span style="color:var(--border)"> / </span>
				{ clusterID }
			</h1>
			<div class="card">
				<table>
					<thead>
						<tr>
							<th>Name</th>
							<th>Namespace</th>
							<th>Schedule</th>
							<th>Next Run</th>
							<th>Last Status</th>
							<th>Avg Duration</th>
							<th>Resources</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						for _, row := range rows {
							<tr>
								<td>
									<a href={ templ.SafeURL(fmt.Sprintf("/clusters/%s/cronjobs/%s/%s/runs", clusterID, row.Namespace, row.Name)) }
									   style="color:var(--accent);text-decoration:none;font-family:var(--font-mono);">
										{ row.Name }
									</a>
								</td>
								<td style="color:var(--text-muted);font-family:var(--font-mono);font-size:0.8rem;">{ row.Namespace }</td>
								<td><code style="color:var(--text-muted);">{ row.Schedule }</code></td>
								<td>
									<span class="countdown" data-ts={ fmt.Sprintf("%d", row.NextRunAt.Unix()) }
									      style="font-family:var(--font-mono);font-size:0.85rem;color:var(--text-muted);">
										{ row.NextRunAt.Format("15:04 02/01") }
									</span>
								</td>
								<td>
									if row.LastRun != nil {
										<span class={ "badge", templ.KV("badge-success", row.LastRun.Status == "succeeded"), templ.KV("badge-failed", row.LastRun.Status == "failed"), templ.KV("badge-running", row.LastRun.Status == "running") }>
											{ row.LastRun.Status }
										</span>
									} else {
										<span style="color:var(--text-muted);">—</span>
									}
								</td>
								<td style="font-family:var(--font-mono);font-size:0.85rem;">
									if row.Stats7d != nil && row.Stats7d.AvgDurationMs != nil {
										{ fmt.Sprintf("%dms", *row.Stats7d.AvgDurationMs) }
									} else {
										<span style="color:var(--text-muted);">—</span>
									}
								</td>
								<td>
									if row.CPURequest != nil {
										<span class="badge badge-muted" style="border-color:var(--border);">cpu:{ *row.CPURequest }</span>
									}
									if row.MemoryRequest != nil {
										<span class="badge badge-muted" style="border-color:var(--border);">mem:{ *row.MemoryRequest }</span>
									}
								</td>
								<td>
									if row.Suspended {
										<button class="btn btn-primary" style="font-size:0.75rem;"
											hx-post={ fmt.Sprintf("/api/clusters/%s/cronjobs/%s/%s/resume", clusterID, row.Namespace, row.Name) }
											hx-confirm="Resume this cronjob?">Resume</button>
									} else {
										<button class="btn btn-muted" style="font-size:0.75rem;"
											hx-post={ fmt.Sprintf("/api/clusters/%s/cronjobs/%s/%s/suspend", clusterID, row.Namespace, row.Name) }
											hx-confirm="Suspend this cronjob?">Suspend</button>
									}
									<button class="btn btn-primary" style="font-size:0.75rem;margin-left:4px;"
										hx-post={ fmt.Sprintf("/api/clusters/%s/cronjobs/%s/%s/trigger", clusterID, row.Namespace, row.Name) }
										hx-confirm="Trigger a manual run?"
										hx-target="body" hx-swap="none">&#9654; Run</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
		<script>
			// Countdown timers
			function updateCountdowns() {
				document.querySelectorAll('.countdown[data-ts]').forEach(el => {
					const diff = parseInt(el.dataset.ts) - Math.floor(Date.now()/1000);
					if (diff <= 0) { el.textContent = 'now'; return; }
					const h = Math.floor(diff/3600), m = Math.floor((diff%3600)/60), s = diff%60;
					el.textContent = h > 0 ? `${h}h ${m}m` : m > 0 ? `${m}m ${s}s` : `${s}s`;
				});
			}
			updateCountdowns();
			setInterval(updateCountdowns, 1000);
		</script>
	}
}
