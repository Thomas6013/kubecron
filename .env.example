# KubeCron — environment variables
# Copy this file to .env and fill in the values.

# Core
KUBECONFIG_DIR=/etc/kubecron/kubeconfigs   # Directory with one kubeconfig file per cluster
DB_PATH=/data/kubecron.db                  # SQLite database file path
PORT=8080                                  # HTTP listen port

# Retention & sampling
RETENTION_DAYS=7                           # Days of run history to keep (default: 7)
METRICS_SAMPLE_INTERVAL=15                 # Resource sampling interval in seconds (default: 15)

# OIDC / SSO (set OIDC_ENABLED=true to activate)
# OIDC_ENABLED=true
# OIDC_ISSUER_URL=https://keycloak.example.com/realms/myrealm
# OIDC_CLIENT_ID=kubecron
# OIDC_CLIENT_SECRET=<client-secret>           # store in a K8s Secret in production
# OIDC_REDIRECT_URL=https://kubecron.example.com/auth/callback  # must be HTTPS in production
# OIDC_SESSION_KEY=<random-string-32-chars>    # store in a K8s Secret in production
